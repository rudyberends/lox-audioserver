{
  "name": "lox-audioserver",
  "version": "4.0.0",
  "description": "Modern TypeScript implementation of the Loxone Audio Server",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudyberends/lox-audioserver.git"
  },
  "main": "dist/server.js",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "concurrently \"npm:watch:server\" \"npm:watch:admin\"",
    "watch:server": "nodemon",
    "watch:admin": "vite build --config vite.admin.config.mts --watch",
    "admin:dev": "vite --config vite.admin.config.mts --host",
    "build": "rimraf ./dist && tsc && tsc-alias -p tsconfig.json",
    "build:admin": "vite build --config vite.admin.config.mts",
    "start": "node dist/server.js",
    "test": "ts-node tests/run-tests.ts",
    "release": "semantic-release",
    "prepare": "husky install .husky"
  },
  "keywords": [],
  "author": "Rudy Berends",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dnssd": "^0.4.5",
    "@types/ndjson": "^2.0.4",
    "@types/node": "^24.10.1",
    "@types/node-rsa": "^1.1.4",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/upnp-mediarenderer-client": "^1.4.3",
    "@types/websocket": "^1.0.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@lox-audio-server/sonos": "^0.1.0",
    "better-sqlite3": "^12.5.0",
    "bonjour-service": "^1.3.0",
    "castv2-client": "^1.2.0",
    "crc": "^4.3.2",
    "egoroof-blowfish": "^4.0.1",
    "ffmpeg-static": "^5.3.0",
    "jimp": "^1.6.0",
    "lox-airplay-sender": "^0.1.0",
    "music-metadata": "^7.14.0",
    "ndjson": "^2.0.0",
    "node-libraop": "^0.1.0",
    "node-librespot": "^0.3.1",
    "node-rsa": "^1.1.1",
    "node-tunein-api": "^0.1.0",
    "protobufjs": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.0",
    "uuidv4": "^6.2.13",
    "websocket": "^1.0.35",
    "widevine": "^1.0.3",
    "ws": "^8.18.3"
  }
}
