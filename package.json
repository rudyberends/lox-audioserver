{
  "name": "lox-audioserver",
  "version": "4.0.0-beta.2",
  "description": "Modern TypeScript implementation of the Loxone Audio Server",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudyberends/lox-audioserver.git"
  },
  "main": "dist/server.js",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0 && npm run depcheck",
    "depcheck": "depcruise --config .dependency-cruiser.cjs src",
    "watch": "nodemon",
    "fetch:admin": "node scripts/fetch-admin-dist.mjs",
    "build": "rimraf ./dist && tsc && tsc-alias -p tsconfig.json && npm run fetch:admin",
    "start": "node dist/server.js",
    "test": "ts-node tests/run-tests.ts",
    "release": "semantic-release",
    "prepare": "husky install .husky"
  },
  "keywords": [],
  "author": "Rudy Berends",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.38.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.1.3",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dnssd": "^0.4.5",
    "@types/ndjson": "^2.0.4",
    "@types/node": "^24.10.1",
    "@types/node-rsa": "^1.1.4",
    "@types/plist": "^3.0.5",
    "@types/upnp-mediarenderer-client": "^1.4.3",
    "@types/websocket": "^1.0.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "dependency-cruiser": "^16.7.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "dependencies": {
    "@lox-audioserver/node-airplay-sender": "^0.4.5",
    "@lox-audioserver/node-libraop": "^0.3.0",
    "@lox-audioserver/node-librespot": "^0.3.2",
    "@lox-audioserver/node-sendspin": "^0.2.0",
    "@lox-audioserver/node-slimproto": "^0.1.0",
    "@lox-audioserver/node-snapcast": "^0.1.0",
    "@lox-audioserver/node-sonos": "^0.1.2",
    "acoustid": "^1.2.1",
    "better-sqlite3": "^12.5.0",
    "bonjour-service": "^1.3.0",
    "castv2-client": "^1.2.0",
    "crc": "^4.3.2",
    "egoroof-blowfish": "^4.0.1",
    "ffmpeg-static": "^5.3.0",
    "jimp": "^1.6.0",
    "music-metadata": "^7.14.0",
    "ndjson": "^2.0.0",
    "node-rsa": "^1.1.1",
    "node-tunein-api": "^0.1.0",
    "protobufjs": "^8.0.0",
    "shazamio-core": "^1.3.1",
    "uuid": "^13.0.0",
    "uuidv4": "^6.2.13",
    "websocket": "^1.0.35",
    "widevine": "^1.0.3",
    "ws": "^8.18.3"
  }
}
