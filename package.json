{
  "name": "lox-audioserver",
  "version": "4.0.0-beta.14",
  "description": "Modern TypeScript implementation of the Loxone Audio Server",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lox-audioserver/lox-audioserver.git"
  },
  "main": "dist/server.js",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0 && npm run depcheck",
    "depcheck": "depcruise --config .dependency-cruiser.cjs src",
    "watch": "nodemon",
    "fetch:admin": "node scripts/fetch-admin-dist.mjs",
    "fetch:player": "node scripts/fetch-player-dist.mjs",
    "build": "rimraf ./dist && tsc && tsc-alias -p tsconfig.json && npm run fetch:admin && npm run fetch:player",
    "start": "node dist/server.js",
    "test": "ts-node --transpile-only tests/run-tests.ts",
    "prepare": "husky .husky"
  },
  "keywords": [],
  "author": "Rudy Berends",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@tsconfig/node20": "^20.1.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dnssd": "^0.4.5",
    "@types/ndjson": "^2.0.4",
    "@types/node": "^25.1.0",
    "@types/node-rsa": "^1.1.4",
    "@types/plist": "^3.0.5",
    "@types/upnp-mediarenderer-client": "^1.4.3",
    "@types/websocket": "^1.0.10",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "overrides": {
    "minimatch": "^10.2.4",
    "@isaacs/brace-expansion": "^5.0.0"
  },
  "dependencies": {
    "@lox-audioserver/node-googlecast": "^0.1.1",
    "@lox-audioserver/node-libraop": "^0.3.6",
    "@lox-audioserver/node-librespot": "^0.4.4",
    "@lox-audioserver/node-sendspin": "^0.3.2",
    "@lox-audioserver/node-slimproto": "0.1.2",
    "@lox-audioserver/node-snapcast": "^0.2.0",
    "@lox-audioserver/node-sonos": "^0.2.2",
    "better-sqlite3": "^12.6.2",
    "bonjour-service": "^1.3.0",
    "crc": "^4.3.2",
    "egoroof-blowfish": "^4.0.2",
    "ffmpeg-static": "^5.3.0",
    "jimp": "^1.6.1",
    "mqtt": "^5.15.1",
    "music-metadata": "^11.12.3",
    "ndjson": "^2.0.0",
    "node-rsa": "^1.1.1",
    "node-tunein-api": "^0.1.0",
    "protobufjs": "^8.2.0",
    "shazamio-core": "^1.3.1",
    "websocket": "^1.0.35",
    "widevine": "^1.0.3",
    "ws": "^8.21.0"
  }
}
