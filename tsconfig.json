{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types"],
    "removeComments": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["client_code"]
}